@article{CuckooHashing,
    author = {Pagh, Rasmus and Rodler, Flemming Friche},
    title = {Cuckoo hashing},
    year = {2004},
    issue_date = {May 2004},
    publisher = {Academic Press, Inc.},
    address = {USA},
    volume = {51},
    number = {2},
    issn = {0196-6774},
    url = {https://doi.org/10.1016/j.jalgor.2003.12.002},
    doi = {10.1016/j.jalgor.2003.12.002},
    abstract = {We present a simple dictionary with worst case constant lookup
                time, equaling the theoretical performance of the classic dynamic
                perfect hashing scheme of Dietzfelbinger et al. [SIAM J. Comput.
                23 (4) (1994) 738-761]. The space usage is similar to that of
                binary search trees. Besides being conceptually much simpler than
                previous dynamic dictionaries with worst case constant lookup
                time, our data structure is interesting in that it does not use
                perfect hashing, but rather a variant of open addressing where
                keys can be moved back in their probe sequences. An
                implementation inspired by our algorithm, but using weaker hash
                functions, is found to be quite practical. It is competitive with
                the best known dictionaries having an average case (but no
                nontrivial worst case) guarantee on lookup time.},
    journal = {J. Algorithms},
    month = may,
    pages = {122–144},
    numpages = {23},
    keywords = {data structures, dictionaries, experiments, hashing, information
                retrieval, searching},
}

